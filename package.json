{
  "name": "whatsapp-number-verifier",
  "version": "1.0.0",
  "private": true,
  "description": "Asynchronous WhatsApp number verification API using Express, BullMQ, Redis and PostgreSQL.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/workers/verification.worker.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:worker": "node dist/workers/verification.worker.js",
    "db:migrate": "tsx src/db/migrate.ts",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bullmq": "^5.40.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.27.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "@types/pg": "^8.15.2",
    "@types/qrcode": "^1.5.5",
    "eslint": "^9.27.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vitest": "^3.2.1"
  },
  "type": "module"
}
